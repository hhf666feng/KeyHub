{
  "name": "keyhub",
  "version": "0.16.1",
  "private": true,
  "description": "KeyHub — a local password and credential manager for AI agents.",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "build:mac": "tauri build --bundles app",
    "build:linux": "tauri build --bundles appimage",
    "build:headless": "cargo build --release --manifest-path src-tauri/Cargo.toml --no-default-features",
    "portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-portable.ps1",
    "portable:mac": "bash scripts/package-portable-macos.sh",
    "portable:linux": "bash scripts/package-portable-linux.sh",
    "portable:headless": "bash scripts/package-headless-linux.sh",
    "release:mac": "npm run build:mac && npm run portable:mac",
    "release:linux": "npm run build:linux && npm run portable:linux",
    "release:headless": "npm run build:headless && npm run portable:headless",
    "check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:browser": "cargo build --manifest-path src-tauri/Cargo.toml --example browser_fixture && node scripts/test-browser.mjs",
    "test:personal-ui": "node scripts/test-personal-ui.mjs",
    "test:controls": "node scripts/test-inline-editor.mjs",
    "test:env-group": "node scripts/test-env-group.mjs",
    "test:passkey-discovery": "node scripts/test-passkey-discovery.mjs",
    "test:dialogs": "node scripts/test-modal-backdrop.mjs",
    "test:workspace": "node scripts/test-workspace-ui.mjs",
    "test:desktop": "node scripts/test-desktop-ui.mjs",
    "test:window": "node scripts/test-workspace-window.mjs && node --test scripts/test-window-zoom.mjs && node scripts/test-titlebar.mjs",
    "test:autofill": "node scripts/test-autofill.mjs",
    "test:login-capture": "cargo build --manifest-path src-tauri/Cargo.toml --example browser_fixture && node scripts/test-login-capture.mjs",
    "test:login-patterns": "node scripts/test-login-patterns.mjs",
    "test:login-flows": "cargo build --manifest-path src-tauri/Cargo.toml --example browser_fixture && node scripts/test-login-flows.mjs",
    "test:public-logins": "node scripts/probe-public-logins.mjs",
    "test:github-ui": "node scripts/test-github-backup-ui.mjs",
    "test:brand": "node --test scripts/test-keyhub-brand.mjs scripts/test-keyhub-packaging.mjs browser-extension/test-rebrand.mjs",
    "test:cli": "node scripts/test-keyhub-cli.mjs",
    "icons:generate": "node scripts/generate-keyhub-icons.mjs",
    "test:logo": "node --test scripts/test-keyhub-logo.mjs && node scripts/generate-keyhub-icons.mjs --check",
    "test:quick": "node --test scripts/test-quick-native-contract.mjs && node scripts/test-quick-panel.mjs",
    "docs:demo": "npm run docs:demo:en && npm run docs:demo:zh-CN",
    "docs:demo:en": "node scripts/capture-readme-demo.mjs --language=en",
    "docs:demo:zh-CN": "node scripts/capture-readme-demo.mjs --language=zh-CN",
    "lint": "node scripts/check-javascript.mjs && node scripts/check-version.mjs",
    "fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:ui": "node scripts/run-tests.mjs ui",
    "test:headless": "cargo test --locked --manifest-path src-tauri/Cargo.toml --no-default-features",
    "check:headless": "cargo check --locked --manifest-path src-tauri/Cargo.toml --no-default-features"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "esbuild": "0.28.2",
    "playwright": "^1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vue": "3.5.44"
  }
}
