{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "OpenKeylet — Local Passwords & Passkeys",
  "version": "0.16.0",
  "description": "Local passwords, passkeys and autofill with your OpenKeylet desktop vault. Requires the OpenKeylet desktop app.",
  "icons": {
    "16": "icons/16x16.png",
    "32": "icons/32x32.png",
    "48": "icons/48x48.png",
    "128": "icons/128x128.png"
  },
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "form-reader.js",
        "content-script.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://*/*",
        "http://localhost/*"
      ],
      "js": [
        "webauthn-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:* http://127.0.0.1:*"
  },
  "action": {
    "default_title": "OpenKeylet",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16x16.png",
      "32": "icons/32x32.png"
    }
  },
  "key": ""
}
